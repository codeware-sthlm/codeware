# Fly.io Integration Test Configuration
# Copy this file to .env.test.local and fill in your values

# Required: Your Fly.io API token
# Get from: https://fly.io/user/personal_access_tokens
FLY_TEST_API_TOKEN=your-test-fly-api-token-here

# Required: Organization name for test apps
# This can be your personal org (usually your username)
FLY_TEST_ORG=my-org-name

# Optional: Enable trace logging for flyctl CLI commands
# Set to 'true' to enable, leave empty or set to 'false' to disable
FLY_TEST_TRACE_CLI=

# Optional: Postgres app name for database tests
# Leave empty to skip database tests
# Create with: flyctl postgres create --name test-fly-node-postgres --region iad --vm-size shared-cpu-1x --volume-size 1
FLY_TEST_POSTGRES=

# Optional: Hostname for the certificate integration tests
# Requesting a certificate writes state into your Fly org, so the add/remove
# cycle is skipped unless you name a hostname here. It never validates —
# nothing is issued and no DNS is needed — and the test removes it again.
# FLY_TEST_CERT_HOSTNAME=fly-node-test.yourdomain.com

# Optional: Specific flyctl version to use
# Defaults to 'latest' if not specified
#FLY_CLI_VERSION=latest
